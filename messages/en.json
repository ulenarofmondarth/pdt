{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "ui": {
    "cmd": {
      "arg": {
        "vtt": {
          "description": "The VTT identity"
        }
      },
      "vtt": {
        "description": "Control a project scored VTT"
      },
      "start": {
        "description": "Start a VTT in the current prolect"
      },
      "init": {
        "description": "Initialise an existing project as a PDT project.",
        "dir": {
          "description": "An existing project directory."
        }
      }
    }
  },
  "fatal": {
    "shouldNeverRun": "Should never run {argv}",
    "noPdtRoot": "Unable to find a PDT root directory. Perhaps you forgot to 'init' this project?"
  },
  "debug": {
    "running": "Running parsed command {argv}"
  }
}
