{
  "Logging": {
    "filename": "pdt.log",
    "level": "warn"
  },
  "VTT": {
    "prj": {
      "server": {
        "type": "foundry",
        "hostname": "localhost",
        "version": "12",
        "port": "auto"
      },
      "host": {
        "type": "docker",
        "image": "felddy/foundryvtt",
        "ports": [
          {
            "internal": 30000,
            "external": "auto"
          }
        ]
      }
    }
  },
  "DOCS": {
    "host": {
      "type": "docker",
      "repository": "ghcr.io",
      "image": "ulenarofmondarth/sphinx-docs",
      "version": "latest",
      "ports": [
        {
          "internal": 8000,
          "external": "auto"
        }
      ]
    }
  }
}
