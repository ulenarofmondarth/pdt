{
  "packages/pdt/**/*.ts": [
    "eslint --fix --max-warnings 0",
    "prettier --write",
    "bash -c 'pnpm --filter @mondarth/pdt typecheck'",
    "pnpm --dir packages/pdt exec vitest related --run"
  ],
  "packages/fvtt-resolver/**/*.ts": [
    "eslint --fix --max-warnings 0",
    "prettier --write",
    "bash -c 'pnpm --filter @mondarth/fvtt-resolver typecheck'",
    "pnpm --dir packages/fvtt-resolver exec vitest related --run"
  ],
  "{*.ts,{tests,scripts}/**/*.ts}": [
    "eslint --fix --max-warnings 0",
    "prettier --write",
    "bash -c 'tsc --noEmit'",
    "vitest related --run"
  ],
  "*.{js,mjs,cjs,json,md,yml,yaml}": ["prettier --write"]
}
