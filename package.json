{
  "name": "@mondarth/pdt",
  "version": "0.1.0",
  "author": "Mark Bools",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ulenarofmondarth/pdt/issues"
  },
  "homepage": "https://github.com/ulenarofmondarth/pdt#readme",
  "main": "dist/index.js",
  "bin": {
    "pdt": "./dist/index.js"
  },
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "vite build  && pnpm run copy-files && chmod +x dist/index.js",
    "build:clean": "pnpm run clean && pnpm run build",
    "test": "vitest --run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist/",
    "copy-files": "copyfiles -u 1 src/pdt-internal-config/**/*.json dist/",
    "test:ci": "vitest run --related",
    "prepare": "husky",
    "build:docs": "DOCS_UID=$(id -u) DOCS_GID=$(id -g) docker compose -f docs/compose.yaml run --rm --no-deps -T docs make html",
    "devserve:docs": "DOCS_UID=$(id -u) DOCS_GID=$(id -g) docker compose -f docs/compose.yaml run --rm --service-ports docs make livehtml",
    "prettier:format": "prettier --config .prettierrc.json --write \"./src/**/*.{ts,js,mjs,json,scss,css}\"",
    "prettier:check": "prettier --config .prettierrc.json --check \"./src/**/*.{ts,js,mjs,json,scss,css}\"",
    "lint-staged": "lint-staged",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:fallback": "tsc6 --noEmit"
  },
  "keywords": [],
  "description": "A CLI tool supporting development of FoundryVTT packages.",
  "devDependencies": {
    "@babel/eslint-parser": "^7.25.8",
    "@commitlint/cli": "21.1.0",
    "@commitlint/config-conventional": "21.1.0",
    "@eslint/js": "^9.18.0",
    "@inlang/paraglide-js": "2.1.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/config": "^3.3.5",
    "@types/dockerode": "^3.3.35",
    "@types/node": "^22.10.7",
    "@types/yargs": "^17.0.33",
    "@vitest/coverage-v8": "~3.2.7",
    "commitizen": "4.3.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "copyfiles": "^2.4.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^50.4.3",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.14.0",
    "husky": "^9.1.3",
    "lint-staged": "^15.5.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "rollup-plugin-node-externals": "^8.0.0",
    "semantic-release": "^25.0.9",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-rename-defaults": "^0.7.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "classic-level": "^2.0.0",
    "config": "^3.3.12",
    "dockerode": "^4.0.4",
    "fast-glob": "^3.3.3",
    "figlet": "^1.8.0",
    "find-up": "^7.0.0",
    "winston": "^3.17.0",
    "yargs": "^17.7.2",
    "zod": "^3.25.67"
  }
}
