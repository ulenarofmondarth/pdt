{
  "name": "@mondarth/pdt",
  "version": "0.1.0",
  "author": "Mark Bools",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ulenarofmondarth/pdt/issues"
  },
  "homepage": "https://github.com/ulenarofmondarth/pdt#readme",
  "main": "dist/index.js",
  "bin": {
    "pdt": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tsc-alias && npm run copy-files && chmod +x dist/index.js",
    "build:clean": "npm run clean && npm run build",
    "dev": "ts-node -r tsconfig-paths/register src/index.ts",
    "debug": "npm run dev",
    "test": "jest",
    "clean": "rimraf dist/",
    "copy-files": "copyfiles -u 1 src/**/*.json dist/",
    "test:ci": "jest -o",
    "prepare": "husky",
    "build:docs": "docker run --rm --user \"$(id -u):$(id -g)\" -v \"$(pwd)/docs\":/docs ghcr.io/ulenarofmondarth/sphinx-docs make html",
    "serve:docs": "docker run --rm --name docserver -d -p 8080:80 -v \"$(pwd)/docs/_build/html\":/usr/share/nginx/html:ro nginx",
    "devserve:docs": "docker run --rm --user \"$(id -u):$(id -g)\" --name docdevserver -d -p 8081:8000 -v \"$(pwd)/docs\":/doc -w /doc ghcr.io/ulenarofmondarth/sphinx-docs sphinx-autobuild --host 0.0.0.0 --port 8000 . _build/html",
    "prettier:format": "prettier --config .prettierrc.json --write \"./src/**/*.{ts,js,mjs,json,scss,css}\"",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [],
  "description": "A CLI tool supporting development of FoundryVTT packages.",
  "devDependencies": {
    "@babel/eslint-parser": "^7.25.8",
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@eslint/js": "^9.18.0",
    "@types/config": "^3.3.5",
    "@types/node": "^22.10.7",
    "@types/yargs": "^17.0.33",
    "commitizen": "4.3.1",
    "copyfiles": "^2.4.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^50.4.3",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.14.0",
    "husky": "^9.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "classic-level": "^2.0.0",
    "config": "^3.3.12",
    "fast-glob": "^3.3.3",
    "figlet": "^1.8.0",
    "winston": "^3.17.0",
    "yargs": "^17.7.2"
  }
}
