{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "target": "es6",
    "module": "nodenext",
    "sourceMap": true,
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "baseUrl": "./src",
    "resolveJsonModule": true,
    "paths": {
      "@/*": [ "*" ],
      "@lib/*": [ "lib/*" ]
    }
  },
  "include": [
    "src/**/*"
  ]
}
