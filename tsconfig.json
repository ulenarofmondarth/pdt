{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "baseUrl": ".",
    "resolveJsonModule": true,
    "allowJs": true,
    "paths": {
      "@/*": ["src/*"],
      "@util/*": ["src/util/*"],
      "@lib/*": ["src/lib/*"],
      "@schema/*": ["src/schema/*"],
      "@i18n/*": ["src/paraglide/*"]
    }
  },
  "tsc-alias": {
    "resolveFullPaths": true
  },
  "include": ["src/**/*"]
}
